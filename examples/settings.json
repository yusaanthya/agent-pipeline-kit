{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook-bootstrap.js\" https://github.com/OWNER/agent-pipeline-kit.git",
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "Bash(gh pr merge:*)"
    ]
  }
}
